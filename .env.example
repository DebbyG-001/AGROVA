# Agrova AI Assistant - LLM Configuration
# Choose ONE of the providers below and add your key:

# OPTION 1: OpenAI (GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# OPTION 2: Groq (100% Free & Lightning Fast - Llama 3.3 70B)
# Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_groq_key_here

# Optional: pick the model. If unset, Groq uses openai/gpt-oss-120b.
# Check which models your key can use at https://console.groq.com/docs/models
# LLM_MODEL=openai/gpt-oss-120b

# OPTION 3: OpenRouter
# OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./agrova.db
